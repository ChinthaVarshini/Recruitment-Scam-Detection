{
  "manifest_version": 3,
  "name": "RecruitmentGuard Job Checker",
  "version": "1.0.0",
  "description": "Check the active job posting with RecruitmentGuard.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Check this job",
    "default_popup": "popup.html"
  }
}
